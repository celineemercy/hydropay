# Server Configuration
FRONTEND_PORT=3000
BACKEND_PORT=8086

# Database
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/
MONGODB_DB=hydropay
MONGODB_COLLECTION=transactions

# Security
CORS_ORIGIN=https://your-frontend-domain.vercel.app
HARDWARE_API_KEY=replace-with-a-long-random-device-secret

# MQTT (Note: Vercel serverless functions cannot maintain persistent MQTT connections)
MQTT_BROKER_URL=mqtt://broker.hivemq.com
MQTT_TOPIC_STATUS=hydropay/status
